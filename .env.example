# ==========================================
# PLEXCRITIC AI - CONFIGURAÇÃO DE AMBIENTE
# ==========================================

# 1. Servidor Plex Media Server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=seu_token_do_plex_aqui

# Nomes das bibliotecas separadas por vírgula
# (Se deixar em branco, analisa automaticamente todas as bibliotecas de filmes, séries e animes)
PLEX_LIBRARY_NAMES=Filmes,Series,Animes

# 2. Provedor de IA (OpenAI / Groq / OpenRouter / etc.)
# Recomendado gratuito via itsfree.ai: Groq (https://console.groq.com)
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_sua_chave_aqui
OPENAI_MODEL=openai/gpt-oss-120b

# 3. Comportamento e Avaliações no Plex
# Preenche as estrelas amarelas (0 a 10) no campo 'Sua Avaliação' do usuário no Plex
AUTO_RATE_PLEX=true

# Atualiza a Frase de Efeito (Tagline) com o veredito rápido (ex: 🎯 Vale a pena • IMDb 8.2)
UPDATE_PLEX_TAGLINE=true

# Adiciona a recomendação no início do texto da Sinopse (Summary)
UPDATE_PLEX_SUMMARY=true
SUMMARY_POSITION=top

# 4. Agendamento e Segurança de Taxa (Rate Limits)
CHECK_INTERVAL_MINUTES=10
DELAY_BETWEEN_ITEMS=5

# 5. Porta do Serviço Web / Webhook
PORT=8080
